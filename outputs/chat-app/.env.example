# Google Cloud Console에서 만든 웹 애플리케이션 OAuth 클라이언트 ID를 넣으세요.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# YouTube Data API v3를 사용해 공개 쇼츠 링크를 불러옵니다.
YOUTUBE_API_KEY=your-youtube-data-api-key

# 관리자만 개발용 SNS 체험 로그인을 사용할 수 있습니다.
SOCIAL_DEMO_LOGIN_ENABLED=true
SOCIAL_DEMO_ADMIN_PASSWORD=choose-a-strong-admin-password
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
