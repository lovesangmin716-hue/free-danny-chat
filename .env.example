# Server
HOST=0.0.0.0
PORT=8765
MAX_REQUEST_THREADS=64
MAX_BODY_READERS=16
HEADER_READ_TIMEOUT_SECONDS=5
BODY_READ_TIMEOUT_SECONDS=10
UPLOAD_READ_TIMEOUT_SECONDS=30
UPLOAD_GRANT_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=60
MAX_SSE_CONNECTIONS=32
MAX_SSE_QUEUE_SIZE=32
SSE_HEARTBEAT_SECONDS=10
EVENT_POLL_INTERVAL_SECONDS=0.1
PRESENCE_TTL_SECONDS=45
# INSTANCE_ID is optional; each process generates a unique value when omitted.
# INSTANCE_ID=render-instance-1
PUBLIC_BASE_URL=http://localhost:8765
# DATA_DIR=/path/to/persistent/data
# COLORLESS_ENV_FILE=/path/to/alternate/.env
# STATE_FILE=/path/to/chat_state.json
# UPLOADS_DIR=/path/to/uploads

# Google OAuth
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8765/auth/google/callback

# YouTube Data API v3
# YOUTUBE_API_KEY=your-youtube-data-api-key
SHORTS_COLLECTION_INTERVAL_SECONDS=1800
SHORTS_COLLECTION_LEASE_SECONDS=120
SHORTS_DAILY_QUOTA_BUDGET=5000
SHORTS_CATALOG_TTL_SECONDS=21600
SHORTS_CATALOG_RETENTION_SECONDS=604800

# Kakao OAuth
# KAKAO_REST_API_KEY=your-kakao-rest-api-key
# KAKAO_CLIENT_SECRET=your-kakao-client-secret
# KAKAO_REDIRECT_URI=http://localhost:8765/auth/kakao/callback

# Development-only authentication
SOCIAL_DEMO_LOGIN_ENABLED=true
SOCIAL_DEMO_ADMIN_PASSWORD=choose-a-strong-admin-password
PHONE_VERIFICATION_MODE=dev

# Optional persistent storage
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# REQUIRE_SUPABASE=true
