{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-review-training.schema.json",
  "type": "object",
  "properties": {
    "example_id": {
      "type": "string"
    },
    "cluster_id": {
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "annotation_status": {
      "enum": [
        "synthetic",
        "human_reviewed"
      ]
    },
    "request": {
      "$ref": "content-review-request.schema.json"
    },
    "response": {
      "$ref": "content-review-response.schema.json"
    },
    "relevant_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "example_id",
    "cluster_id",
    "split",
    "annotation_status",
    "request",
    "response"
  ],
  "additionalProperties": false
}
