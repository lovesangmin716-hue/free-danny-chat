{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-review-request.schema.json",
  "type": "object",
  "properties": {
    "task": {
      "const": "joint_content_review"
    },
    "schema_version": {
      "const": "1"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "submission": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 2000
        },
        "body": {
          "type": "string",
          "maxLength": 20000
        },
        "language": {
          "enum": [
            "ko",
            "en",
            "mixed",
            "auto"
          ]
        },
        "source_kind": {
          "enum": [
            "thread",
            "article"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "modified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "followers"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "body",
        "language",
        "source_kind",
        "source_url",
        "original_id",
        "published_at",
        "modified_at",
        "first_observed_at",
        "parent_id",
        "root_id",
        "visibility"
      ],
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 2000
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          },
          "scope": {
            "enum": [
              "public",
              "blocked"
            ]
          },
          "source_kind": {
            "enum": [
              "thread",
              "article"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "modified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "block_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": [
              "number",
              "null"
            ]
          },
          "segment_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "scope",
          "source_kind",
          "source_url",
          "original_id",
          "published_at",
          "modified_at",
          "first_observed_at",
          "policy_version",
          "block_reason",
          "expires_at",
          "segment_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "task",
    "schema_version",
    "policy_version",
    "submission",
    "candidates"
  ],
  "additionalProperties": false
}
